# ========================================
# SITE CONFIGURATION
# ========================================

# Produktions-URL (wichtig für SEO, Sitemap und Open Graph)
NEXT_PUBLIC_SITE_URL=https://elektrovolt.at

# ========================================
# EMAIL CONFIGURATION
# ========================================

# Option 1: RESEND (Empfohlen für Production - einfach & zuverlässig)
# Registriere dich auf https://resend.com (100 E-Mails/Tag kostenlos)
# 1. Erstelle einen API Key
# 2. Verifiziere deine Domain ODER nutze 'onboarding@resend.dev' für Tests
RESEND_API_KEY=
# Falls du eine eigene Domain verifiziert hast:
RESEND_FROM=info@elektrovolt.at

# Empfänger-E-Mail für Kontaktformular-Nachrichten
CONTACT_TO=info@elektrovolt.at

# ========================================
# RECHTSDATEN (WICHTIG FÜR IMPRESSUM)
# ========================================

NEXT_PUBLIC_COMPANY_UID_NUMMER=ATU71545447
NEXT_PUBLIC_COMPANY_FIRMA_NUMMER=FN461066p

# ========================================
# Option 2: SMTP (Fallback, wenn kein RESEND_API_KEY gesetzt)
# ! ACHTUNG: Gmail benötigt App-Passwort, nicht normales Passwort !
# ========================================

# SMTP Server (z.B. smtp.gmail.com, smtp.office365.com, smtp.ionos.de)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 für TLS, 465 für SSL)
SMTP_PORT=587

# SMTP Username (meist Ihre E-Mail-Adresse)
SMTP_USER=ihre-email@beispiel.com

# SMTP Password (App-Passwort für Gmail: https://myaccount.google.com/apppasswords)
SMTP_PASS=ihr-smtp-passwort

# SMTP Secure Connection (true für SSL Port 465, false für TLS Port 587)
SMTP_SECURE=false

# ========================================
# OPTIONAL SERVICES
# ========================================

# Optional: Gemini API Key für Emergency Assistant (kann leer bleiben)
GEMINI_API_KEY=
